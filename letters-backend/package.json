{
  "name": "letters-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "kb:backfill": "tsx src/scripts/backfillPaperKb.ts",
    "kb:verify": "tsx src/scripts/verifyPaperKb.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.18.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@supabase/supabase-js": "^2.93.2",
    "@trpc/server": "^11.8.1",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "epub-gen-memory": "^1.1.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "image-size": "^2.0.2",
    "jose": "^6.1.0",
    "openai": "^6.17.0",
    "pgvector": "^0.2.1",
    "postgres": "^3.4.7",
    "superjson": "^2.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.4.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
