# Database (Supabase PostgreSQL with pgvector)
# 使用 Transaction Pooler (端口 6543)，推荐用于 Docker 部署
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT (use Supabase JWT secret from project settings)
JWT_SECRET=your-supabase-jwt-secret

# AI (Chat Completion)
BUILT_IN_FORGE_API_KEY=your-openai-api-key
BUILT_IN_FORGE_BASE_URL=https://api.openai.com/v1
BUILT_IN_FORGE_MODEL=gpt-4
# Optional: vision-capable model for image understanding (paper figures)
BUILT_IN_FORGE_VISION_MODEL=gpt-4o-mini

# AI Image Generation (for novel covers)
# Falls back to BUILT_IN_FORGE_* if IMAGE_GEN_API_KEY is not set
IMAGE_GEN_API_KEY=your-image-api-key
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=dall-e-3

# Embedding Model (for RAG)
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Cloudflare R2 Storage (optional - for cover images and exports)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=letters-storage
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Google Custom Search (optional - for paper figure analysis web search)
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_CX=your-google-cse-cx

# Knowledge provider for papers: pgvector | vertex | hybrid
KNOWLEDGE_PROVIDER=hybrid

# GCP / Vertex RAG (optional, required for vertex/hybrid)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_RAG_SOURCE_BUCKET=your-rag-source-bucket
VERTEX_INDEX_NAME=your-vector-index-name
VERTEX_INDEX_ENDPOINT_NAME=your-vector-index-endpoint-name
VERTEX_RAG_EMBEDDING_MODEL=publishers/google/models/text-embedding-005
VERTEX_GROUNDING_GOOGLE_ENABLED=true

# Server
PORT=30080
NODE_ENV=production

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=https://your-frontend-domain.com,http://localhost:30081
